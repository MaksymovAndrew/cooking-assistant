# Server-side environment for the deployed stack.
# Copy to /srv/cooking-assistant/.env on the server, fill in real values, chmod 600.
# Never commit the filled-in file - this template is the only version that belongs in git.

# Images published by the deploy workflow. IMAGE_TAG is rewritten by deploy.sh on every release,
# which is also what makes a rollback a one-line change.
BACKEND_IMAGE=ghcr.io/<owner>/cooking-backend
FRONTEND_IMAGE=ghcr.io/<owner>/cooking-frontend
# must not be empty - deploy.sh reads it to know what to roll back to
IMAGE_TAG=latest

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database runs as a container on the project network, so DB_HOST is the service name.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Required: production defaults SSL on, and the local container serves no TLS.
DB_SSL=false

# Exactly one reverse proxy (Caddy) sits in front.
TRUST_PROXY_HOPS=1

# Must match the site origin exactly - a wrong value is invisible to curl and blocks every
# browser request.
CORS_ORIGIN=https://<app-domain>
# Leading dot so the app and api subdomains share the session cookie.
COOKIE_DOMAIN=.<app-domain>

# At least 32 characters. Keep the value stable across deploys or every session is invalidated.
JWT_SECRET_KEY=

# Transactional email. Both must be set together, or both left empty for the logging fallback.
RESEND_API_KEY=
EMAIL_FROM=
